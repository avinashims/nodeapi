DATABASE_URL="mysql://root:password@localhost:3306/ecommerce_db"
PORT=3000
NODE_ENV=development

# Access JWT (15 minutes)
JWT_ACCESS_SECRET="your-access-token-secret-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"

# Legacy fallback if JWT_ACCESS_SECRET unset
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Refresh tokens (7 days in Redis, HttpOnly cookie)
JWT_REFRESH_TTL_SECONDS=604800
COOKIE_SAME_SITE="lax"

# Frontend origin for CORS + cookies
CLIENT_URL="http://localhost:5173"

# Redis (required for refresh-token auth)
REDIS_URL="redis://localhost:6379"
REDIS_DEFAULT_TTL=300

# Secret required in body to create an ADMIN via POST /api/auth/register-admin
ADMIN_REGISTRATION_SECRET="change-this-admin-secret"

# Razorpay (get keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
