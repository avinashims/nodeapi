DATABASE_URL="mysql://root:password@localhost:3306/ecommerce_db"
PORT=3000
NODE_ENV=development

# Access JWT (15 minutes) + refresh token (7 days in MySQL)
JWT_SECRET="your-secret-key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_DAYS=7
COOKIE_SAME_SITE="lax"

# Frontend origin for CORS + cookies
CLIENT_URL="http://localhost:5173"

# Password reset link expiry (hours)
PASSWORD_RESET_HOURS=1

# SMTP (for password reset emails — optional in local dev)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
MAIL_FROM="noreply@example.com"

# Redis (optional — product/dashboard cache only)
REDIS_URL="redis://localhost:6379"
REDIS_DEFAULT_TTL=300

# Secret required in body to create an ADMIN via POST /api/auth/register-admin
ADMIN_REGISTRATION_SECRET="change-this-admin-secret"

# Razorpay (get keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"

MYSQL_ROOT_PASSWORD=avinash123
MYSQL_DATABASE=ecommerce_db_qa
MYSQL_USER=ecom_user
